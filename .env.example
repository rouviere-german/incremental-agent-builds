# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=incremental-agent-builds
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run incremental-agent-builds generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Agentic kit. Tests, demo and bench run offline and never need a key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0

APP_DATA_DIR=var

# Build API bearer tokens (HS256). Without a secret the scoped routes answer 503.
APP_JWT_SECRET=
APP_JWT_ISSUER=incremental-agent-builds
APP_JWT_AUDIENCE=incremental-agent-builds
APP_JWT_MAX_TTL_SECONDS=3600

# Build engine. The workspace holds the sources; the store holds traces and the CAS.
APP_WORKSPACE_DIR=var/workspace
APP_STORE_DIR=var/store
APP_BUILD_JOBS=4
APP_BUILD_LLM_CONCURRENCY=4
APP_BUILD_GUARD_MODE=warn
# base64, >= 32 bytes. Generated under APP_DATA_DIR when empty.
APP_STORE_MAC_KEY=
# Ed25519 seed for signing exported cache entries: uv run iab keygen
APP_CACHE_SIGNING_SEED=
# Comma-separated base64 Ed25519 public keys whose cache entries may be imported.
APP_CACHE_TRUSTED_KEYS=
APP_PLAN_APPROVAL_USD_MICROS=250000
# Also require approval when a plan's cost cannot be estimated (a first build).
APP_PLAN_APPROVE_UNESTIMATED=false
APP_APPROVAL_TTL_SECONDS=3600
